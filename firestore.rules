rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION & ROLE HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Single Fixed Super Admin: Verified via pre-configured admin email OR Firestore user role
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'sandeeprana4519@gmail.com' ||
          request.auth.token.email == 'admin@rexonsecurity.com' ||
          request.auth.token.email == 'admin@rexon.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    // Multi-tenant company membership verification
    function isCompanyMember(companyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          (request.auth.token.companyId != null && request.auth.token.companyId == companyId) ||
          (getUserData().companyId != null && getUserData().companyId == companyId)
        ))
      );
    }

    function isAdmin(companyId) {
      return isCompanyMember(companyId) && isSuperAdmin();
    }

    // Field Officer verification: Must belong to company and be approved by Super Admin
    function isApprovedOfficer(companyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().companyId == companyId &&
        (request.auth.token.role == 'field_officer' || getUserData().role == 'field_officer') &&
        (getUserData().isApproved == true || getUserData().isApproved == null);
    }

    // ==========================================
    // 1. USER PROFILES & ROLES (/users/{userId})
    // ==========================================
    match /users/{userId} {
      // Users can read their own profile; Super Admins can read all profiles
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isSuperAdmin()
      );

      // Only Super Admin can provision user documents, or the fixed admin on first boot
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (
          request.auth.token.email == 'sandeeprana4519@gmail.com' ||
          request.auth.token.email == 'admin@rexonsecurity.com' ||
          request.auth.token.email == 'admin@rexon.com'
        ))
      );

      // Critical Security Rule: Non-admins can NEVER self-elevate roles or change approval status
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId', 'officerId', 'isApproved'])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 2. MULTI-TENANT COMPANY DATA (/companies/{companyId})
    // ==========================================
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      allow write: if isSuperAdmin();

      // SITES: Strictly managed by Super Admin ONLY (Create/Update/Delete)
      // Field officers and clients have read-only visibility
      match /sites/{siteId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // OFFICERS: Managed EXCLUSIVELY by Super Admin
      // No officer or normal user can add, edit, or approve officers
      match /officers/{officerId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // ASSIGNMENTS: Managed exclusively by Super Admin; Officers read their schedules
      match /assignments/{assignmentId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // PATROL REPORTS:
      // - Super Admin can read all reports, edit verification status, or delete
      // - Approved Field officers can ONLY create and read reports for their own assigned identity
      match /patrolReports/{reportId} {
        allow read: if isCompanyMember(companyId) && (
          isSuperAdmin() ||
          (
            isApprovedOfficer(companyId) && (
              resource.data.officerId == getUserData().officerId ||
              resource.data.officerId == request.auth.uid
            )
          ) ||
          (
            getUserData().role in ['company_owner', 'company_hr', 'company_manager'] &&
            (
              resource.data.siteId in getUserData().assignedSiteIds ||
              resource.data.clientName == getUserData().companyName
            )
          )
        );

        allow create: if isCompanyMember(companyId) && (
          isSuperAdmin() ||
          (
            isApprovedOfficer(companyId) &&
            request.resource.data.officerId != null &&
            (
              request.resource.data.officerId == getUserData().officerId ||
              request.resource.data.officerId == request.auth.uid
            ) &&
            request.resource.data.gpsStatus.verified == true &&
            request.resource.data.gpsStatus.distanceDeviationMeters <= 100 &&
            request.resource.data.gpsStatus.accuracyMeters <= 20
          )
        );

        allow update: if isCompanyMember(companyId) && (
          isSuperAdmin() ||
          (
            isApprovedOfficer(companyId) &&
            (
              resource.data.officerId == getUserData().officerId ||
              resource.data.officerId == request.auth.uid
            )
          )
        );

        allow delete: if isSuperAdmin();
      }

      // INCIDENTS: Super Admin full control; Approved Officers can log incidents
      match /incidents/{incidentId} {
        allow read: if isCompanyMember(companyId);
        allow create: if isSuperAdmin() || isApprovedOfficer(companyId);
        allow update, delete: if isSuperAdmin();
      }

      // ZONES: Sector configuration managed exclusively by Super Admin
      match /zones/{zoneId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // CLIENT COMPANIES: Managed exclusively by Super Admin
      match /clientCompanies/{clientCompanyId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // CLIENT ACCOUNTS: Managed exclusively by Super Admin
      match /clientAccounts/{accountId} {
        allow read: if isCompanyMember(companyId) && (
          isSuperAdmin() || request.auth.uid == accountId
        );
        allow write: if isSuperAdmin();
      }
    }
  }
}
