rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // AUTHENTICATION & ROLE HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Single Fixed Super Admin: Verified via configured Admin UID 'CRGIZ0zLonatw6METbQ0UB2T1lf1',
    // configured Admin Email 'admin.sandeep@rexon.com', or Firestore 'admin' role.
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'CRGIZ0zLonatw6METbQ0UB2T1lf1' ||
        request.auth.token.email == 'admin.sandeep@rexon.com' ||
        request.auth.token.email == 'sandeeprana4519@gmail.com' ||
        request.auth.token.email == 'admin@rexonsecurity.com' ||
        request.auth.token.email == 'admin@rexon.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    // Company user verification
    function isCompanyUser(companyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'company' &&
        getUserData().companyId == companyId &&
        (getUserData().status == 'active' || getUserData().status == null);
    }

    // Field Officer verification: Must belong to company and be active/approved
    function isApprovedOfficer(companyId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().companyId == companyId &&
        (request.auth.token.role == 'field_officer' || getUserData().role == 'field_officer') &&
        (getUserData().status == 'active' || getUserData().status == null) &&
        (getUserData().isApproved == true || getUserData().isApproved == null);
    }

    // Multi-tenant company membership verification
    function isCompanyMember(companyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        isCompanyUser(companyId) ||
        isApprovedOfficer(companyId) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          (request.auth.token.companyId != null && request.auth.token.companyId == companyId) ||
          (getUserData().companyId != null && getUserData().companyId == companyId)
        ))
      );
    }

    function isAdmin(companyId) {
      return isCompanyMember(companyId) && isSuperAdmin();
    }

    // ==========================================
    // 1. USER PROFILES & ROLES (/users/{userId})
    // ==========================================
    match /users/{userId} {
      // Users can read their own profile; Super Admins can read all profiles
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isSuperAdmin()
      );

      // Super Admin can provision any user; Fixed Admin UID/Email can create their own document on login
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && (
          request.auth.uid == 'CRGIZ0zLonatw6METbQ0UB2T1lf1' ||
          request.auth.token.email == 'admin.sandeep@rexon.com' ||
          request.auth.token.email == 'sandeeprana4519@gmail.com'
        ))
      );

      // Only Super Admin can update roles, companyId, or approval/status
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'companyId', 'officerId', 'status', 'isApproved'])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 2. MULTI-TENANT COMPANY DATA (/companies/{companyId})
    // ==========================================
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      allow write: if isSuperAdmin();

      // SITES: Managed exclusively by Super Admin. Read-only for assigned Company & Officers
      match /sites/{siteId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // OFFICERS: Managed EXCLUSIVELY by Super Admin
      match /officers/{officerId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // ASSIGNMENTS: Managed by Super Admin; Officers & Company read schedules
      match /assignments/{assignmentId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // PATROL REPORTS:
      // - Super Admin: Full CRUD
      // - Company: Read reports matching their company/site
      // - Officers: Create & Read reports for their assigned duties
      match /patrolReports/{reportId} {
        allow read: if isCompanyMember(companyId) && (
          isSuperAdmin() ||
          (
            isCompanyUser(companyId) && (
              resource.data.siteId == getUserData().companyId ||
              resource.data.clientName == getUserData().companyName
            )
          ) ||
          (
            isApprovedOfficer(companyId) && (
              resource.data.officerId == getUserData().officerId ||
              resource.data.officerId == request.auth.uid
            )
          ) ||
          (
            getUserData().role in ['company_owner', 'company_hr', 'company_manager'] &&
            (
              resource.data.siteId in getUserData().assignedSiteIds ||
              resource.data.clientName == getUserData().companyName
            )
          )
        );

        allow create: if isCompanyMember(companyId) && (
          isSuperAdmin() ||
          (
            isApprovedOfficer(companyId) &&
            request.resource.data.officerId != null &&
            (
              request.resource.data.officerId == getUserData().officerId ||
              request.resource.data.officerId == request.auth.uid
            )
          )
        );

        allow update: if isCompanyMember(companyId) && (
          isSuperAdmin() ||
          (
            isApprovedOfficer(companyId) &&
            (
              resource.data.officerId == getUserData().officerId ||
              resource.data.officerId == request.auth.uid
            )
          )
        );

        allow delete: if isSuperAdmin();
      }

      // INCIDENTS: Super Admin full control; Approved Officers & Company can log incidents
      match /incidents/{incidentId} {
        allow read: if isCompanyMember(companyId);
        allow create: if isSuperAdmin() || isApprovedOfficer(companyId) || isCompanyUser(companyId);
        allow update, delete: if isSuperAdmin();
      }

      // ZONES: Sector configuration managed exclusively by Super Admin
      match /zones/{zoneId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // CLIENT COMPANIES: Managed exclusively by Super Admin
      match /clientCompanies/{clientCompanyId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }

      // CLIENT ACCOUNTS: Managed exclusively by Super Admin
      match /clientAccounts/{accountId} {
        allow read: if isCompanyMember(companyId) && (
          isSuperAdmin() || request.auth.uid == accountId
        );
        allow write: if isSuperAdmin();
      }
    }
  }
}
